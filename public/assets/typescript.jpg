<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e3a8a"/>
      <stop offset="50%" stop-color="#2563eb"/>
      <stop offset="100%" stop-color="#3b82f6"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#60a5fa"/>
      <stop offset="100%" stop-color="#93c5fd"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000" flood-opacity="0.3"/>
    </filter>
  </defs>
  <rect width="800" height="500" rx="16" fill="url(#bgGrad)"/>
  <circle cx="700" cy="80" r="140" fill="#ffffff" fill-opacity="0.05"/>
  <circle cx="100" cy="420" r="180" fill="#ffffff" fill-opacity="0.04"/>
  <g transform="translate(140, 100)" filter="url(#shadow)">
    <rect width="180" height="180" rx="28" fill="#3178c6"/>
    <text x="90" y="125" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="105" font-weight="900" fill="#ffffff" text-anchor="middle">TS</text>
  </g>
  <g transform="translate(360, 130)">
    <rect width="140" height="34" rx="17" fill="#ffffff" fill-opacity="0.2"/>
    <text x="70" y="22" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="2">ATELIER PRATIQUE</text>
    <text x="0" y="85" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="38" font-weight="800" fill="#ffffff">TypeScript 5 &amp; Angular</text>
    <text x="0" y="120" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="18" fill="#bfdbfe">Typage avancé • Generics • Signals</text>
  </g>
  <g transform="translate(80, 420)">
    <rect width="640" height="2" fill="url(#accentGrad)" fill-opacity="0.4"/>
    <text x="0" y="30" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="600" fill="#dbeafe">EventHub Campus Tech</text>
    <text x="640" y="30" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="700" fill="#60a5fa" text-anchor="end">GRATUIT</text>
  </g>
</svg>
